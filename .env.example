# --- Database -----------------------------------------------------------
# Local dev (SQLite). For Vercel use Postgres connection strings instead.
DATABASE_URL="file:./prisma/settyflow.db"

# Vercel/Neon Postgres (uncomment for production):
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Owner auth (single-setter v1) --------------------------------------
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-this-to-a-real-password
OWNER_NAME=Setter
SESSION_SECRET=generate-with-openssl-rand-base64-32

# --- Unipile ------------------------------------------------------------
# Get these from app.unipile.com → Settings/Access Tokens
UNIPILE_DSN=api41.unipile.com:17121
UNIPILE_API_KEY=

# Optional shared secret for verifying webhook auth from Unipile
UNIPILE_WEBHOOK_SECRET=
